# ── Required ──────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── Admin user IDs (comma-separated) ─────────────────────────────────────────
ADMIN_IDS=123456789,987654321

# ── Database path (defaults to fayda_bot.db in working dir) ──────────────────
DB_PATH=fayda_bot.db

# ── Wallet / billing ──────────────────────────────────────────────────────────
FREE_TRIALS=1
CARD_COST=5.0
REFERRAL_BONUS=10.0
TOPUP_ACCOUNT=0912345678 (TeleBirr)

# ── Background removal (optional — falls back to Pillow/NumPy) ────────────────
REMOVEBG_API_KEY=

# ── Bot username (without @) — auto-detected if blank ────────────────────────
BOT_USERNAME=

# ── Support Telegram username (without @) ────────────────────────────────────
SUPPORT_USERNAME=YourSupportHandle
